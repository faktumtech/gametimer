    "eslint-plugin-vue": "^10.5.1",
    "eslint-plugin-vuetify": "^2.1.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.0"
